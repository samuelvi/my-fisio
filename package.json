{
    "type": "module",
    "private": true,
    "packageManager": "pnpm@11.1.1",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite --mode dev",
        "build": "vite build --mode prod",
        "build:test": "vite build --mode test",
        "typecheck": "tsc --noEmit",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "lint": "eslint assets --ext .ts,.tsx",
        "deps:check": "node scripts/security/check-package.mjs",
        "deps:add": "node scripts/security/pnpm-safe-add.mjs --save-prod",
        "deps:add:dev": "node scripts/security/pnpm-safe-add.mjs --save-dev",
        "deps:audit": "pnpm audit --audit-level high",
        "deps:install": "pnpm install --frozen-lockfile --ignore-scripts"
    },
    "dependencies": {
        "@fullcalendar/daygrid": "^6.1.19",
        "@fullcalendar/interaction": "^6.1.19",
        "@fullcalendar/react": "^6.1.19",
        "@fullcalendar/timegrid": "^6.1.19",
        "@headlessui/react": "^2.2.9",
        "@heroicons/react": "^2.2.0",
        "@tanstack/react-query": "^5.62.9",
        "axios": "^1.16.0",
        "fuse.js": "^7.1.0",
        "react": "^18.2.0",
        "react-datepicker": "^9.1.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^7.15.0"
    },
    "devDependencies": {
        "@cucumber/cucumber": "^11.3.0",
        "@faker-js/faker": "^10.2.0",
        "@playwright/test": "^1.57.0",
        "@testing-library/jest-dom": "^6.7.0",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^25.0.3",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.59.3",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.16",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^5.2.0",
        "fishery": "^2.4.0",
        "jsdom": "^26.1.0",
        "playwright-bdd": "^8.5.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^6.4.2",
        "vite-plugin-symfony": "^8.2.4",
        "vitest": "^2.1.8"
    }
}
